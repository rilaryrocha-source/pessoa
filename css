*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body{
    background: #d11d1d;
    font-family: Arial, Helvetica, sans-serif;
}

.container{
    width: 600px;
    margin: 50px auto;
    background: rgb(183, 41, 65);
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0,0,0,2);
}

h1{
    color: rgb(205, 131, 97);
    margin-bottom: 20px;
}

button{
    background: rgb(215, 68, 27);
    color: #f58e8e;
    border: none;
    padding: 12px 25px;
    cursor: pointer;
    border-radius: 6px;
    font-size: 16px;
}

button:hover{
    background: #bfcd27;
}

#resultado{
     margin-top: 25px;
     background: gray;
     padding: 20px;
     border-radius: 8px;
     font-size: 16px;
}
